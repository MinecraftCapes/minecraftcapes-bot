    "bugs": {
        "url": "https://github.com/MinecraftCapes/minecraftcapes-bot/issues"
    },
    "homepage": "https://minecraftcapes.net/",
    "dependencies": {
        "axios": "^1.20.0",
        "discord.js": "^14.27.0",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "nodemon": "^3.1.14",
        "npm-check-updates": "^23.1.0",
        "prettier": "^3.9.6"
    }
