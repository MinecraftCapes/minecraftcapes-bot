    "version": "1.1.0",
    "description": "Bot for MinecraftCapes",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "prod": "node src/index.js",
        "dev": "nodemon src/index.js",
        "format": "npm run lint && npm run prettier",
